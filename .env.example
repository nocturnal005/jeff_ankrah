# Environment variables required by the serverless functions in /api.
#
# This file documents the NAMES only and is committed. The real values live in
# Vercel's environment variables (Project Settings -> Environment Variables)
# and, for local development, in .env.local, which .gitignore keeps out of git.
#
# Nothing in here is read by the browser. The publishable Supabase key that the
# browser does use is a different key and lives in js/config.js on purpose.

# Stripe. Prefer a restricted key (rk_...) over a full secret key (sk_...):
# it only needs permission to write Checkout Sessions and read Payment Intents.
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint, from the Stripe dashboard or from
# `stripe listen`. Without it the webhook refuses every request, which is the
# correct failure: an unverified webhook can be forged by anyone.
STRIPE_WEBHOOK_SECRET=

# Supabase. The service role key bypasses row level security and is the only
# way a booking row can be written, because the schema deliberately grants no
# insert policy to anon. It must never appear in js/config.js or any page.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin used to build Stripe's return URLs. Taken from an
# environment variable rather than the request's Host header, which a caller
# can forge to redirect a paying customer to a site we do not own.
SITE_URL=https://casttco.online

# Consultation price in pence. Server-side only: the browser never sends a
# price, or a customer could book a fifty pound consultation for one penny.
CONSULTATION_PRICE_PENCE=5000
